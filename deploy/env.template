# Copy to deploy/.env on the VPS and replace every CHANGE_ME value.
# Never commit deploy/.env or send its contents in chat.
APP_DOMAIN=hatamestate.com
CADDY_EMAIL=CHANGE_ME@example.com
NODE_ENV=production
HATAM_RUNTIME=vps
HATAM_DATA_DIR=/app/data
HATAM_INTERNAL_ORIGIN=http://app:3000
# سقف ایمنی مطلق فضای دیسک؛ محدودیت‌های قابل تنظیم پنل باید کمتر از این مقدار باشند.
HATAM_UPLOAD_HARD_LIMIT_MB=512

# Generate three different values, for example: openssl rand -hex 32
AUTH_SECRET=CHANGE_ME_AUTH_SECRET
INTEGRATION_SECRET_KEY=CHANGE_ME_INTEGRATION_SECRET_KEY
AUTOMATION_SECRET=CHANGE_ME_AUTOMATION_SECRET

# Exact provider API hostnames, comma separated; no scheme/path/wildcard.
# Keep empty until the SMS and payment providers are selected.
INTEGRATION_ALLOWED_HOSTS=api.panelchi.com,api.zarinpal.com,www.zarinpal.com

# Optional fallback. Prefer configuring the selected AI provider in /admin/integrations.
OPENAI_API_KEY=
