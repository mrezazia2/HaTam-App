{
  "name": "hatam-mobile-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "test:smoke": "node --test tests/api-smoke.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-icons": "^1.3.2",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "@use-gesture/react": "^10.3.1",
    "drizzle-orm": "0.45.2",
    "leaflet": "^1.9.4",
    "motion": "^12.42.2",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "react-server-dom-webpack": "19.3.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.1.0",
    "vite": "8.3.4",
    "wrangler": "4.149.0"
  },
  "overrides": {
    "baseline-browser-mapping": "2.11.26",
    "fflate": "0.7.5",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "source-map-js": "1.2.2",
    "next": {
      "sharp": "0.35.5"
    }
  },
  "type": "module",
  "displayName": "املاک حاتم"
}
